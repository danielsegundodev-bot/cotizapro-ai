# Copia este archivo a .env y completa los valores. .env está en .gitignore: NUNCA lo subas.

# Clave del Panel de Propietario (usa una frase larga y única, 16+ caracteres)
COTIZAPRO_OWNER_PASSWORD=

# Stripe: clave secreta (sk_live_... o una restricted key con lectura de Checkout Sessions y Subscriptions).
# Se usa SOLO en el servidor para confirmar que un pago es real antes de emitir la licencia PRO.
STRIPE_SECRET_KEY=
# Opcional: IDs de tus Payment Links (plink_...) separados por coma; solo esos pagos desbloquean PRO.
STRIPE_PAYMENT_LINK_IDS=
